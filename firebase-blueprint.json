{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information and settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique identifier for the user (matching Auth UID)." },
        "displayName": { "type": "string", "description": "Public name of the user." },
        "photoURL": { "type": "string", "description": "URL to the user's profile picture." },
        "bio": { "type": "string", "description": "Short bio about the user." },
        "favoriteRecipeIds": { "type": "array", "description": "List of recipe IDs marked as favorite." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "A food recipe shared by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "Name of the dish." },
        "description": { "type": "string", "description": "Brief overview of the recipe." },
        "ingredients": { "type": "array", "description": "List of ingredient strings." },
        "instructions": { "type": "array", "description": "Step-by-step instructions." },
        "category": { "type": "string", "enum": ["Breakfast", "Lunch", "Dinner", "Dessert", "Snack", "Vegan", "Vegetarian", "Keto"] },
        "imageUrl": { "type": "string" },
        "authorId": { "type": "string", "description": "User ID of the recipe creator." },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "likesCount": { "type": "number", "description": "Number of users who liked this recipe." },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ingredients", "instructions", "authorId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A user comment on a recipe.",
      "type": "object",
      "properties": {
        "recipeId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipeId", "userId", "text", "createdAt"]
    },
    "Like": {
      "title": "Like",
      "description": "A like interaction between a user and a recipe.",
      "type": "object",
      "properties": {
        "recipeId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipeId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and private user profiles."
    },
    "/recipes/{recipeId}": {
      "schema": "Recipe",
      "description": "All shared recipes."
    },
    "/recipes/{recipeId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments for a specific recipe."
    },
    "/recipes/{recipeId}/likes/{userId}": {
      "schema": "Like",
      "description": "Likes for a specific recipe, keyed by userId for uniqueness."
    }
  }
}
