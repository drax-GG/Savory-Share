rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.userId == request.auth.uid 
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (data.bio == null || (data.bio is string && data.bio.size() <= 500))
        && (data.favoriteRecipeIds == null || (data.favoriteRecipeIds is list && data.favoriteRecipeIds.size() <= 100));
        // Removed strict timestamp check for simplicity in prototype
    }

    function isValidRecipe(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.ingredients is list && data.ingredients.size() > 0 && data.ingredients.size() <= 100
        && data.instructions is list && data.instructions.size() > 0 && data.instructions.size() <= 100
        && data.authorId == request.auth.uid
        && data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert', 'Snack', 'Vegan', 'Vegetarian', 'Keto'];
    }

    function isValidComment(data) {
      return data.recipeId is string && isValidId(data.recipeId)
        && data.userId == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000;
    }

    function isValidLike(data) {
      return data.recipeId is string && isValidId(data.recipeId)
        && data.userId == request.auth.uid;
    }

    // --- Collection Routes ---

    // Users
    match /users/{userId} {
      allow read: if true; // Profile pages are public
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Allow updating specific profile fields
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'favoriteRecipeIds'])
      );
    }

    // Recipes
    match /recipes/{recipeId} {
      allow read: if true; // Recipes are public
      allow create: if isSignedIn() && isValidRecipe(incoming());
      allow update: if isSignedIn() && (
        // Author can update everything
        (isOwner(existing().authorId) && isValidRecipe(incoming())) ||
        // Others can only increment/decrement likes/comments count
        (!isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasAny(['likesCount', 'commentsCount']))
      );
      allow delete: if isOwner(existing().authorId);

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidComment(incoming());
        allow delete: if isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/recipes/$(recipeId)).data.authorId);
      }

      // Likes sub-collection (keyed by userId)
      match /likes/{likingUserId} {
        allow read: if true;
        allow create: if isOwner(likingUserId) && isValidLike(incoming());
        allow delete: if isOwner(likingUserId);
      }
    }
  }
}
